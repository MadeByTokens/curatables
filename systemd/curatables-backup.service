[Unit]
Description=Curatables — daily database + config backup snapshot
After=curatables.service
RequiresMountsFor=/home/curatables/curatables-data

[Service]
Type=oneshot
User=curatables
Group=curatables
Environment=CURATABLES_DATA_DIR=/home/curatables/curatables-data
Environment=RETAIN=14
# Snapshots go to /var/lib/curatables-backups (systemd creates it, owned
# by the service user). That is on the SD card / system disk, so with an
# external media drive the backups survive the drive failing, and vice versa.
StateDirectory=curatables-backups
StateDirectoryMode=0700
ExecStart=/opt/curatables/scripts/backup.sh /var/lib/curatables-backups

# Hardening — same posture as the main service. The videos drive is
# writable only for the optional second copy of each backup.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=-/mnt/curatables-media
ProtectHome=read-only
PrivateTmp=true
