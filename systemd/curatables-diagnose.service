[Unit]
Description=Curatables: write a diagnostics report to the SD card
Documentation=https://github.com/MadeByTokens/curatables
# Runs only when curatables-diagnose.txt is on the boot partition, once the
# network has had a chance to come up. See syshelper/bootfs.py.
After=network-online.target curatables.service curatables-helper.service
Wants=network-online.target
ConditionPathExists=/boot/firmware/curatables-diagnose.txt

[Service]
Type=oneshot
Environment=CURATABLES_ROOT=/opt/curatables
Environment=CURATABLES_DATA=/home/curatables/curatables-data
Environment=CURATABLES_USER=curatables
ExecStartPre=/bin/sleep 45
ExecStart=/usr/bin/python3 -I /opt/curatables/scripts/curatables-helper.py --report-from-boot
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
