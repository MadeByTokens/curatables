[Unit]
Description=Curatables system helper (passwords, Wi-Fi, drives, diagnostics)
Documentation=https://github.com/MadeByTokens/curatables
# The web app runs unprivileged and asks this helper, over a Unix socket
# that only the curatables user may use, for the few things that need
# root. It does only what syshelper/ registers as an action, and passes
# every value as a separate argument, never through a shell. Read
# syshelper/ before trusting it.
After=local-fs.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
Environment=CURATABLES_ROOT=/opt/curatables
Environment=CURATABLES_DATA=/home/curatables/curatables-data
Environment=CURATABLES_USER=curatables
ExecStart=/usr/bin/python3 -I /opt/curatables/scripts/curatables-helper.py
Restart=on-failure
RestartSec=3
# No ProtectKernelModules=: mounting a drive can load its filesystem
# module, and system updates install kernel modules.
PrivateTmp=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
